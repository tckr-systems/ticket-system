<%= turbo_stream.replace dom_id(@ticket) do %>
  <%= render partial: "tickets/ticket", locals: { ticket: @ticket } %>
<% end %>

<%= turbo_stream.replace "ticket_form_panel" do %>
  <%= tag.turbo_frame id: "ticket_form_panel", data: { controller: "edit-panel" } do %>
    <div class="rounded-3xl border border-emerald-400/30 bg-emerald-500/10 px-6 py-5 backdrop-blur-xl">
      <p class="text-sm font-semibold text-emerald-200">
        ✓ Seat <%= @ticket.seat_id_seq %> updated for <%= @ticket.name %>.
      </p>
      <p class="mt-1 text-xs text-emerald-300/70">The vault already reflects the change.</p>
      <p class="mt-3">
        <%= link_to "Done — back to vault", root_path, class: "btn-ghost text-emerald-200" %>
      </p>
    </div>
  <% end %>
<% end %>

<%= turbo_stream.replace "sold_count" do %>
  <span id="sold_count" class="text-4xl font-black leading-none text-cyan-300 tabular-nums"><%= Ticket.count %></span>
<% end %>