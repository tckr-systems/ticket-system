<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "HoloTek Ticket Vault" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full" data-controller="modal">
    <div class="venue-glow venue-glow--top pointer-events-none fixed" aria-hidden="true"></div>
    <div class="venue-glow venue-glow--bottom pointer-events-none fixed" aria-hidden="true"></div>
    <div class="scanlines pointer-events-none fixed inset-0" aria-hidden="true"></div>

    <main class="relative mx-auto w-full max-w-6xl px-4 pb-24 pt-12 sm:px-6">
      <% if notice.present? %>
        <div class="mb-6 rounded-2xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-6 rounded-2xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <%= tag.turbo_frame id: "ticket_modal", data: { modal_target: "frame" } %>
  </body>
</html>